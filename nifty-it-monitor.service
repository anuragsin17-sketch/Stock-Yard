[Unit]
Description=Nifty IT Index Monitor - 500 Point Drop Alert
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/nifty_it_monitor.py
Restart=always
RestartSec=10
Environment="TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN"
Environment="TELEGRAM_CHAT_ID=YOUR_CHAT_ID"

[Install]
WantedBy=multi-user.target
